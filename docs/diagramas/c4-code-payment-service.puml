package "com.javeriana.eventos.payment\n.infrastructure.messaging" as pkg_messaging #F9EBEA {

  class InscripcionEventConsumerListener <<RabbitListener>> {
    ' @Component  @RabbitListener
    ' queue: payment.inscription.created
    - crearOrdenPagoService: CrearOrdenPagoService
    ==
    + onInscripcionCreada(\n  event: InscripcionCreadaEvent): void
    ' @RabbitListener(queues="payment.inscription.created")
    - construirComando(\n  event: InscripcionCreadaEvent): CrearOrdenPagoCommand
  }

