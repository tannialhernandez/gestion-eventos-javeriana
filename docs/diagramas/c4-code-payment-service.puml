package "com.javeriana.eventos.payment\n.infrastructure.gateway" as pkg_gateway #FEF5E7 {

  class MercadoPagoAdapter <<HttpClientAdapter>> {
    ' implements PasarelaPagoPort
    ' WireMock en perfil local/test -- API real en prod
    - wireMockBaseUrl: String {${payment.gateway.url}}
    - restTemplate: RestTemplate
    ==
    + crearOrdenPago(monto: BigDecimal,\n  moneda: String,\n  inscripcionId: UUID): OrdenPagoDto
    + consultarEstado(\n  referenciaExterna: String): EstadoPagoDto
    + emitirReembolso(\n  referenciaExterna: String): ReembolsoDto
  }

  note bottom of MercadoPagoAdapter
    En perfil local/test:
    baseUrl = http://wiremock:8089
    Stubs en /infrastructure/wiremock/mappings/
