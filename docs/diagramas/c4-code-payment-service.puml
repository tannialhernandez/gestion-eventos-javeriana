' PAQUETE: infrastructure.persistence
' ============================================================
package "com.javeriana.eventos.payment\n.infrastructure.persistence" as pkg_persistence #E8F8F5 {

  class PagoJpaAdapter <<JpaAdapter>> {
    ' @Repository
    - jpaRepository: PagoJpaRepository
    ==
    + guardar(pago: Pago): Pago
    + buscarPorId(id: UUID): Optional<Pago>
    + buscarPorReferenciaExterna(\n  ref: String): Optional<Pago>
    + buscarPorInscripcionId(\n  inscripcionId: UUID): Optional<Pago>
  }

  interface PagoJpaRepository <<JpaRepository>> {
    ' extends JpaRepository<PagoEntity, UUID>
    + findByReferenciaExterna(\n  ref: String): Optional<PagoEntity>
    + findByInscripcionId(\n  inscripcionId: UUID): Optional<PagoEntity>
  }

  class IdempotencyKeyJpaAdapter <<JpaAdapter>> {
    ' @Repository
    - jpaRepository: IdempotencyKeyJpaRepository
    ==
    + guardar(key: IdempotencyKey): IdempotencyKey
    + buscarPorKey(key: String): Optional<IdempotencyKey>
    + existeKey(key: String): boolean
  }

  interface IdempotencyKeyJpaRepository <<JpaRepository>> {
    ' extends JpaRepository<IdempotencyKeyEntity, String>
    + existsByKey(key: String): boolean
  }

  class OutboxJpaAdapter <<JpaAdapter>> {
    ' @Repository
    - jpaRepository: OutboxJpaRepository
    ==
    + guardar(evento: OutboxEvent): OutboxEvent
    + buscarPendientes(limite: int): List<OutboxEvent>
    + marcarProcesado(id: UUID): void
  }

  interface OutboxJpaRepository <<JpaRepository>> {
    ' extends JpaRepository<OutboxEventEntity, UUID>
    + findByProcessedAtIsNullOrderByCreatedAtAsc(\n  pageable: Pageable): List<OutboxEventEntity>
  }
}

