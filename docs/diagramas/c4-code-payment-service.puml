' PAQUETE: infrastructure.rest
' ============================================================
package "com.javeriana.eventos.payment\n.infrastructure.rest" as pkg_rest #FEF5E7 {

  class PagoRestController <<RestController>> {
    ' @RestController
    - crearOrdenPagoService: CrearOrdenPagoService
    - procesarWebhookService: ProcesarWebhookService
    ==
    + iniciarPago(req: IniciarPagoRequest):\n  ResponseEntity<PagoDto>
    ' @PostMapping("/api/v1/pagos")
    + consultarPago(id: UUID): ResponseEntity<PagoDto>
