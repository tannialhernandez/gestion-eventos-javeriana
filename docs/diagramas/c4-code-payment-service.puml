CrearOrdenPagoService   "1" o--> "1" PagoRepository            : pagoRepository
CrearOrdenPagoService   "1" o--> "1" PasarelaPagoPort          : pasarelaPagoPort\n[WireMock/MercadoPago]
CrearOrdenPagoService   "1" o--> "1" OutboxRepository          : outboxRepository
CrearOrdenPagoService   "1" o--> "1" IdempotencyKeyRepository  : idempotencyKeyRepository

ConfirmarPagoService    "1" o--> "1" PagoRepository            : pagoRepository
ConfirmarPagoService    "1" o--> "1" OutboxRepository          : outboxRepository\n[ADR-011] PagoConfirmado

RechazarPagoService     "1" o--> "1" PagoRepository            : pagoRepository
RechazarPagoService     "1" o--> "1" OutboxRepository          : outboxRepository\n[ADR-011] PagoRechazado

ProcesarWebhookService  "1" o--> "1" PagoRepository            : pagoRepository
ProcesarWebhookService  "1" o--> "1" ConfirmarPagoService      : confirmarPagoService
ProcesarWebhookService  "1" o--> "1" RechazarPagoService       : rechazarPagoService
ProcesarWebhookService  "1" o--> "1" PasarelaPagoPort          : pasarelaPagoPort

OutboxRelayService      "1" o--> "1" OutboxRepository          : outboxRepository
OutboxRelayService      "1" o--> "1" EventPublisher            : eventPublisher

' ============================================================
' RELACIONES: REST -> Application
' ============================================================
PagoRestController "1" o--> "1" CrearOrdenPagoService  : crearOrdenPagoService
PagoRestController "1" o--> "1" ProcesarWebhookService : procesarWebhookService

' ============================================================
' RELACIONES: Messaging -> Application
' ============================================================
InscripcionEventConsumerListener "1" o--> "1" CrearOrdenPagoService : crearOrdenPagoService

' ============================================================
' RELACIONES: Driven Adapters -> Ports
' ============================================================
PagoJpaAdapter              ..|> PagoRepository
IdempotencyKeyJpaAdapter    ..|> IdempotencyKeyRepository
OutboxJpaAdapter            ..|> OutboxRepository
MercadoPagoAdapter          ..|> PasarelaPagoPort
PagoRabbitPublisherAdapter  ..|> EventPublisher

PagoJpaAdapter           "1" o--> "1" PagoJpaRepository           : jpaRepository
IdempotencyKeyJpaAdapter "1" o--> "1" IdempotencyKeyJpaRepository  : jpaRepository
OutboxJpaAdapter         "1" o--> "1" OutboxJpaRepository          : jpaRepository

' ============================================================
' LEYENDA
' ============================================================
legend right
  <b>Capas -- Arquitectura Hexagonal</b>
  |<back:#9B59B6><color:white>  AggregateRoot     </color></back>| Raiz de agregado (Dominio)         |
  |<back:#3C7DD9><color:white>  Entity            </color></back>| Entidad de dominio                 |
  |<back:#F0C040>  Enumeration    </back>| Enumeracion de dominio             |
  |<back:#27AE60><color:white>  Port              </color></back>| Puerto / Interfaz del hexagono     |
  |<back:#2980B9><color:white>  ApplicationSvc    </color></back>| Servicio de aplicacion (caso uso)  |
  |<back:#E67E22><color:white>  AppSvc PENDIENTE  </color></back>| Servicio pendiente de implementar  |
  |<back:#E67E22><color:white>  RestController    </color></back>| Adaptador primario REST            |
  |<back:#8E44AD><color:white>  RabbitListener    </color></back>| Adaptador primario RabbitMQ        |
  |<back:#A04000><color:white>  HttpClientAdapter </color></back>| Adaptador pasarela (WireMock/API)  |
  |<back:#1ABC9C><color:white>  JpaAdapter        </color></back>| Adaptador secundario JPA           |
  |<back:#117A65><color:white>  JpaRepository     </color></back>| Repositorio Spring Data JPA        |
  |<back:#8E44AD><color:white>  RabbitPublisher   </color></back>| Publicador AMQP (Outbox relay)     |
  ====
  [ADR-006] RabbitMQ: InscripcionEventConsumerListener
            consume payment.inscription.created
  [ADR-011] OutboxEvent publicado en misma TX que Pago
            OutboxRelayService [PENDIENTE] relay a RabbitMQ
  [ADR-012] Dependency Rule: infra -> app -> domain
            PasarelaPagoPort invierte dependencia de WireMock
  [ADR-019] DLQ configurado en RabbitMqTopologyConfig
            3 reintentos -> payment.inscription.created.dlq
end legend

@enduml
