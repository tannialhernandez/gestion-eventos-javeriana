@startuml c4-code-payment-service
' C4 Nivel 4: Vista de Codigo - Payment Service (Procesamiento + Mock pasarela)
' Plataforma de Gestion de Eventos Academicos - Arquitectura Hexagonal
'
' Materializa:
'   ADR-006 -- RabbitMQ como message broker
'   ADR-011 -- Transactional Outbox Pattern
'   ADR-012 -- Arquitectura Hexagonal (Ports & Adapters)
'   ADR-019 -- Estrategia DLQ para mensajes fallidos
'
' Estado: 70% implementado
' PENDIENTE: OutboxRelayService (rama feat/payment-outbox-e2e)
' WireMock: mock de pasarela de pagos (sin integracion real en prototipo)
'
' Generado: 2026-05-22

!theme plain
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 55
skinparam backgroundColor #F9F9F9
skinparam roundcorner 8
skinparam shadowing false
skinparam defaultFontSize 10

skinparam class {
  BackgroundColor<<AggregateRoot>>            #EDE0F5
  BorderColor<<AggregateRoot>>                #7B2D8B
  HeaderBackgroundColor<<AggregateRoot>>      #9B59B6

  BackgroundColor<<Entity>>                   #EAF0FB
  BorderColor<<Entity>>                       #2E5FA3
  HeaderBackgroundColor<<Entity>>             #3C7DD9

  BackgroundColor<<Enumeration>>              #FEF9E7
  BorderColor<<Enumeration>>                  #C8A400
  HeaderBackgroundColor<<Enumeration>>        #F0C040

  BackgroundColor<<Port>>                     #EAFAF1
  BorderColor<<Port>>                         #1E8449
  HeaderBackgroundColor<<Port>>               #27AE60

  BackgroundColor<<ApplicationService>>       #EBF5FB
  BorderColor<<ApplicationService>>           #1A5276
  HeaderBackgroundColor<<ApplicationService>> #2980B9

  BackgroundColor<<ApplicationServicePending>> #FEF9E7
  BorderColor<<ApplicationServicePending>>     #A04000
  HeaderBackgroundColor<<ApplicationServicePending>> #E67E22

  BackgroundColor<<RestController>>           #FEF5E7
  BorderColor<<RestController>>               #A04000
  HeaderBackgroundColor<<RestController>>     #E67E22

  BackgroundColor<<RabbitListener>>           #F9EBEA
  BorderColor<<RabbitListener>>               #7D3C98
  HeaderBackgroundColor<<RabbitListener>>     #8E44AD

  BackgroundColor<<JpaAdapter>>               #E8F8F5
  BorderColor<<JpaAdapter>>                   #148F77
  HeaderBackgroundColor<<JpaAdapter>>         #1ABC9C

  BackgroundColor<<JpaRepository>>            #E8F6F3
  BorderColor<<JpaRepository>>                #0E6655
  HeaderBackgroundColor<<JpaRepository>>      #117A65

  BackgroundColor<<HttpClientAdapter>>        #FEF5E7
  BorderColor<<HttpClientAdapter>>            #784212
  HeaderBackgroundColor<<HttpClientAdapter>>  #A04000

  BackgroundColor<<RabbitPublisher>>          #F9EBEA
  BorderColor<<RabbitPublisher>>              #7D3C98
  HeaderBackgroundColor<<RabbitPublisher>>    #8E44AD

  FontColor #FFFFFF
}

title
  <b><size:16>C4 Nivel 4: Vista de Codigo -- Payment Service (Procesamiento + Mock Pasarela)</size></b>
  <size:13>Plataforma de Gestion de Eventos Academicos | Arquitectura Hexagonal | Spring Boot 3 / Java 17</size>
  <size:11><color:#E67E22>70% implementado</color>  |  <color:#2980B9>ADR-011: Transactional Outbox</color>  |  <color:#8E44AD>ADR-006: RabbitMQ</color>  |  <color:#E74C3C>ADR-019: DLQ</color></size>
end title

' ============================================================
' PAQUETE: domain.model
' ============================================================
package "com.javeriana.eventos.payment\n.domain.model" as pkg_domain_model #EDE0F5 {

  class Pago <<AggregateRoot>> {
    - id: UUID
    - inscripcionId: UUID
    - monto: BigDecimal
    - moneda: String
    - estado: EstadoPago
    - referenciaExterna: String {nullable}
    - idempotencyKey: String
    - creadoEn: LocalDateTime
    - confirmadoEn: LocalDateTime {nullable}
    - metadatosPasarela: String {JSON, nullable}
    ==
    + confirmar(referenciaExterna: String,\n  metadatos: String): void
    + rechazar(motivo: String): void
    + reembolsar(): void
    + estaConfirmado(): boolean
    + estaPendiente(): boolean
  }

  enum EstadoPago <<Enumeration>> {
    INICIADO
    PENDIENTE_PASARELA
    CONFIRMADO
    RECHAZADO
    REEMBOLSADO
  }

  class IdempotencyKey <<Entity>> {
    - key: String
    - pagoId: UUID
    - creadoEn: LocalDateTime
    ==
    + getKey(): String
    + getPagoId(): UUID
  }

  class OutboxEvent <<Entity>> {
    - id: UUID
    - aggregateType: String
    - aggregateId: UUID
    - eventType: String
    - payload: String {JSON}
    - createdAt: LocalDateTime
    - processedAt: LocalDateTime {nullable}
    - attempts: int
    ==
    + marcarProcesado(): void
    + incrementarIntentos(): void
  }
}

' ============================================================
' PAQUETE: domain.port
' ============================================================
package "com.javeriana.eventos.payment\n.domain.port" as pkg_domain_port #EAFAF1 {

  interface PagoRepository <<Port>> {
    + guardar(pago: Pago): Pago
    + buscarPorId(id: UUID): Optional<Pago>
    + buscarPorReferenciaExterna(\n  ref: String): Optional<Pago>
    + buscarPorInscripcionId(\n  inscripcionId: UUID): Optional<Pago>
  }

  interface IdempotencyKeyRepository <<Port>> {
    + guardar(key: IdempotencyKey): IdempotencyKey
    + buscarPorKey(key: String): Optional<IdempotencyKey>
    + existeKey(key: String): boolean
  }

  interface OutboxRepository <<Port>> {
    + guardar(evento: OutboxEvent): OutboxEvent
    + buscarPendientes(limite: int): List<OutboxEvent>
    + marcarProcesado(id: UUID): void
  }

  interface EventPublisher <<Port>> {
    + publicar(evento: OutboxEvent): void
  }

  interface PasarelaPagoPort <<Port>> {
    ' WireMock en prototipo -- MercadoPago real en prod
    + crearOrdenPago(monto: BigDecimal,\n  moneda: String,\n  inscripcionId: UUID): OrdenPagoDto
    + consultarEstado(referenciaExterna: String): EstadoPagoDto
    + emitirReembolso(referenciaExterna: String): ReembolsoDto
  }
}

' ============================================================
' PAQUETE: application.service
' ============================================================
package "com.javeriana.eventos.payment\n.application.service" as pkg_application #EBF5FB {

  class CrearOrdenPagoService <<ApplicationService>> {
    ' @Transactional
    - pagoRepository: PagoRepository
    - pasarelaPagoPort: PasarelaPagoPort
    - outboxRepository: OutboxRepository
    - idempotencyKeyRepository: IdempotencyKeyRepository
    ==
    + ejecutar(comando: CrearOrdenPagoCommand): Pago
    - verificarIdempotencia(key: String): Optional<Pago>
  }

  class ConfirmarPagoService <<ApplicationService>> {
    ' @Transactional
    - pagoRepository: PagoRepository
    - outboxRepository: OutboxRepository
    ==
    + ejecutar(comando: ConfirmarPagoCommand): Pago
    - publicarPagoConfirmado(pago: Pago): void
  }

  class RechazarPagoService <<ApplicationService>> {
    ' @Transactional
    - pagoRepository: PagoRepository
    - outboxRepository: OutboxRepository
    ==
    + ejecutar(pagoId: UUID, motivo: String): Pago
    - publicarPagoRechazado(pago: Pago): void
  }

  class ProcesarWebhookService <<ApplicationService>> {
    ' @Transactional  Idempotente por referenciaExterna
    - pagoRepository: PagoRepository
    - confirmarPagoService: ConfirmarPagoService
    - rechazarPagoService: RechazarPagoService
    - pasarelaPagoPort: PasarelaPagoPort
    ==
    + ejecutar(payload: WebhookPayload): void
    - esWebhookDuplicado(\n  referenciaExterna: String): boolean
    - manejarPagoTardio(pago: Pago,\n  ref: String): void
  }

  class OutboxRelayService <<ApplicationServicePending>> {
    ' @Scheduled(fixedDelay=2000)  @SchedulerLock
    ' PENDIENTE -- rama feat/payment-outbox-e2e
    - outboxRepository: OutboxRepository
    - eventPublisher: EventPublisher
    ==
    + procesarEventosPendientes(): void
    - procesarLote(eventos: List<OutboxEvent>): void
  }

  note top of OutboxRelayService
    <color:red><b>PENDIENTE -- Sprint actual</b></color>
    Rama: feat/payment-outbox-e2e
    Sin este servicio, PaymentConfirmedEvent
    y PaymentFailedEvent NO se publican
    a RabbitMQ desde payment_db.
    Bloquea test E2E del flujo completo.
  end note

  class CrearOrdenPagoCommand {
    + inscripcionId: UUID
    + monto: BigDecimal
    + moneda: String
    + idempotencyKey: String
  }

  class ConfirmarPagoCommand {
    + pagoId: UUID
    + referenciaExterna: String
    + metadatosPasarela: String
  }
}

