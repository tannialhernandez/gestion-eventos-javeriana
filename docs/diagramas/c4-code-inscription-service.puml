title
  <b><size:16>C4 Nivel 4: Vista de Código — Inscription Service (Core de Concurrencia)</size></b>
  <size:13>Plataforma de Gestión de Eventos Académicos | Arquitectura Hexagonal | Spring Boot 3 / Java 17</size>
  <size:11><color:#9B59B6>ADR-012: SELECT FOR UPDATE</color>  |  <color:#2980B9>ADR-008: Transactional Outbox</color>  |  <color:#8E44AD>ADR-018: ShedLock</color></size>
end title

' ============================================================
' PAQUETE: domain.model
' ============================================================
package "com.javeriana.eventos.inscripciones\n.domain.model" as pkg_domain_model #EDE0F5 {

  class Inscripcion <<AggregateRoot>> {
    - id: UUID
    - usuarioId: UUID
    - eventoId: UUID
    - estado: EstadoInscripcion
    - creadaEn: LocalDateTime
    - expiraEn: LocalDateTime
    - confirmadaEn: LocalDateTime {nullable}
    - referenciaPago: String {nullable}
    ==
    + confirmar(): void
    + cancelar(motivo: String): void
    + expirar(): void
    + estaPendiente(): boolean
    + haExpirado(): boolean
  }

  class Evento <<Entity>> {
    - id: UUID
    - nombre: String
    - aforoMaximo: int
    - cuposDisponibles: int
    - estado: EstadoEvento
    - inicioEn: LocalDateTime
    ==
    + tieneCupoDisponible(): boolean
    + decrementarCupo(): void
    + incrementarCupo(): void
    + estaActivo(): boolean
  }

  enum EstadoInscripcion <<Enumeration>> {
    PENDIENTE
    CONFIRMADA
    CANCELADA
    EXPIRADA
  }

  enum EstadoEvento <<Enumeration>> {
    BORRADOR
    PUBLICADO
    AGOTADO
    FINALIZADO
    CANCELADO
  }

  class PoliticaCancelacion <<DomainService>> {
    ==
    + puedeCancelarse(inscripcion: Inscripcion,\n  evento: Evento): boolean
    + aplicaReembolso(inscripcion: Inscripcion,\n  evento: Evento): boolean
  }

  class OutboxEvent <<Entity>> {
    - id: UUID
    - aggregateType: String
    - aggregateId: UUID
    - eventType: String
    - payload: String {JSON}
    - createdAt: LocalDateTime
    - processedAt: LocalDateTime {nullable}
    - attempts: int
    ==
    + marcarProcesado(): void
    + incrementarIntentos(): void
  }
}

' ============================================================
' PAQUETE: domain.port
' ============================================================
package "com.javeriana.eventos.inscripciones\n.domain.port" as pkg_domain_port #EAFAF1 {

  interface InscripcionRepository <<Port>> {
    + guardar(inscripcion: Inscripcion): Inscripcion
    + buscarPorId(id: UUID): Optional<Inscripcion>
    + buscarPendientesExpiradas(\n  antesDe: LocalDateTime): List<Inscripcion>
    + existeInscripcionActiva(\n  usuarioId: UUID, eventoId: UUID): boolean
  }

  interface EventoRepository <<Port>> {
    + buscarPorIdConBloqueoPesimista(\n  id: UUID): Optional<Evento>
    + guardar(evento: Evento): Evento
  }

  interface OutboxRepository <<Port>> {
    + guardar(evento: OutboxEvent): OutboxEvent
    + buscarPendientes(limite: int): List<OutboxEvent>
    + marcarProcesado(id: UUID): void
  }

  interface EventPublisher <<Port>> {
    + publicar(evento: OutboxEvent): void
  }
}

' ============================================================
' PAQUETE: application.service
' ============================================================
package "com.javeriana.eventos.inscripciones\n.application.service" as pkg_application #EBF5FB {

  class CrearInscripcionService <<ApplicationService>> {
    ' @Transactional
    - inscripcionRepository: InscripcionRepository
    - eventoRepository: EventoRepository
    - outboxRepository: OutboxRepository
    ==
    + ejecutar(comando: CrearInscripcionCommand): InscripcionDto
    - validarReglasNegocio(\n  usuarioId: UUID, eventoId: UUID): void
    - crearInscripcion(\n  usuarioId: UUID, evento: Evento): Inscripcion
    - registrarEventoOutbox(\n  inscripcion: Inscripcion): void
  }

  class ConfirmarInscripcionService <<ApplicationService>> {
    ' @Transactional
    - inscripcionRepository: InscripcionRepository
    - outboxRepository: OutboxRepository
    ==
    + ejecutar(inscripcionId: UUID,\n  referenciaPago: String): void
  }

  class CancelarInscripcionService <<ApplicationService>> {
    ' @Transactional
    - inscripcionRepository: InscripcionRepository
    - eventoRepository: EventoRepository
    - outboxRepository: OutboxRepository
    - politicaCancelacion: PoliticaCancelacion
    ==
    + ejecutar(inscripcionId: UUID,\n  motivo: String): void
  }

  class ExpirarInscripcionesPendientesService <<ApplicationService>> {
    ' @Scheduled(fixedDelay=60000)  @SchedulerLock
    - inscripcionRepository: InscripcionRepository
    - cancelarInscripcionService: CancelarInscripcionService
    ==
    + ejecutar(): void
  }

  class OutboxRelayService <<ApplicationService>> {
    ' @Scheduled(fixedDelay=2000)  @SchedulerLock
    - outboxRepository: OutboxRepository
    - eventPublisher: EventPublisher
    ==
    + procesarEventosPendientes(): void
    - procesarLote(eventos: List<OutboxEvent>): void
  }
}

