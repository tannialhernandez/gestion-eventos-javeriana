# Copiar este archivo como .env y ajustar los valores
# El archivo .env NO debe commitearse (está en .gitignore)

# PostgreSQL
POSTGRES_USER=eventos_user
POSTGRES_PASSWORD=eventos_pass

# RabbitMQ
RABBITMQ_USER=eventos_user
RABBITMQ_PASSWORD=eventos_pass

# JWT
JWT_SECRET=cambia-esto-por-una-clave-secreta-de-al-menos-256-bits

# Google OAuth2 (obtener en console.cloud.google.com)
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret

# MercadoPago Sandbox (obtener en developers.mercadopago.com)
MERCADOPAGO_ACCESS_TOKEN=TEST-tu-access-token
MERCADOPAGO_WEBHOOK_SECRET=tu-webhook-secret

# AWS S3 (puede usarse localstack para desarrollo local)
AWS_ACCESS_KEY_ID=tu-access-key
AWS_SECRET_ACCESS_KEY=tu-secret-key
AWS_S3_BUCKET=eventos-javeriana-certificados
AWS_REGION=us-east-1
