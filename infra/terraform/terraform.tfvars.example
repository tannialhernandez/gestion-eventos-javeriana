aws_region            = "us-east-1"
project_name          = "eventos-javeriana"
environment           = "dev"
vpc_cidr              = "10.0.0.0/16"
ec2_instance_type     = "t3.small"
rds_instance_class    = "db.t4g.micro"
postgres_engine_version = "15.18"
elasticache_node_type = "cache.t3.micro"
redis_engine_version  = "7.0"
mq_instance_type      = "mq.t3.micro"
rabbitmq_engine_version = "3.13"

# Reemplazar antes de terraform apply real.
payment_webhook_secret = "change-me-before-production"
